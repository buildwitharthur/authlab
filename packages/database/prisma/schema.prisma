generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  memberNumber Int      @unique @default(autoincrement())
  joinedAt     DateTime @default(now())
  showWall     Boolean  @default(true)
}
