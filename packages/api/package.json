{
  "name": "@authlab/api",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "env:load": "dotenv -e ../../.env --",
    "dev": "pnpm env:load tsx watch src/server.ts",
    "start": "pnpm env:load node build/server.js"
  },
  "type": "module",
  "dependencies": {
    "@authlab/database": "workspace:*",
    "@authlab/email": "workspace:*",
    "@authlab/env": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@node-rs/argon2": "^2.2.1",
    "@scalar/fastify-api-reference": "^1.69.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@authlab/ts-config": "workspace:*",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
